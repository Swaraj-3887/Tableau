      <aliases enabled='yes' />
      <column caption='Price fillter Category' datatype='string' name='[Calculation_0898076353073154]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt;[Parameters].[Parameter 0898076352036865]&#13;&#10;THEN &quot;Above Limit&quot;&#13;&#10;ELSE &quot;Below Limit&quot;&#13;&#10;END' />
      </column>
      <column caption='Bed Criteria' datatype='string' name='[Calculation_0898076356325382]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Beds] &gt; [Parameters].[Parameter 0898076355735557]&#13;&#10;THEN &quot;Optimum Number of beds&quot;&#13;&#10;ELSE &quot;Not Enough Beds&quot;&#13;&#10;END' />
      </column>
      <column caption='Hotel Count' datatype='integer' name='[Calculation_0898076359192584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Name])' />
      </column>
      <column caption='Hot Since_NEW' datatype='date' name='[Calculation_0898076361015305]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='Property Type New' datatype='string' name='[Calculation_0898076362944522]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Property Type],&quot;Unkonw&quot;)' />
      </column>
      <column caption='Reviwe Category' datatype='string' name='[Calculation_1426116477149184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews] &gt;= 100 THEN &quot;High Reviwed&quot;&#13;&#10;ELSE &quot;Less Reviwed&quot;&#13;&#10;END' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_1426116477485057]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since] &lt;= TODAY() THEN &quot;Active Host&quot;&#13;&#10;ELSE &quot;New Host&quot;&#13;&#10;END' />
      </column>
      <column caption='Reviwe performance score' datatype='integer' name='[Calculation_1742226066944000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]*[Review Scores Rating]' />
      </column>
      <column caption='Price Category' datatype='string' name='[Calculation_1742226067906561]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;=300 THEN &quot;LUXURY&quot;&#13;&#10;&#13;&#10;ELSEIF [Price]&gt;=150 THEN &quot;STANDARD&quot;&#13;&#10;&#13;&#10;ELSE &quot;BUDGET&quot;&#13;&#10;&#13;&#10;END' />
      </column>
